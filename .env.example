# Copy this file to .env and fill in real values before running docker-compose.
# Never commit the real .env file.

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# --- Postgres ---
POSTGRES_DB=duobromart
POSTGRES_USER=duobromart
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000/api
VITE_GOOGLE_CLIENT_ID=

# --- Used to build links in emails (verification, password reset) that
# point at the React app rather than the API. ---
FRONTEND_URL=http://localhost:5173

# --- Social login (Phase 2 §2.2). Leave blank to keep the Google/Facebook
# buttons hidden — signup/login still work fully via email + password. ---
GOOGLE_OAUTH_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# --- reCAPTCHA on signup (§4.4.8). Leave blank in dev — real keys wired
# in Phase 8 hardening. ---
RECAPTCHA_SECRET_KEY=

# --- Email (used from Phase 2 onward: verification, resets, order emails) ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1

# --- Payment gateways (used from Phase 4 onward — never store raw card data) ---
PAYMENT_GATEWAY_PUBLIC_KEY=
PAYMENT_GATEWAY_SECRET_KEY=
