# Copy this file to .env and fill in real values before running docker-compose.
# Never commit the real .env file.

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# --- Postgres ---
POSTGRES_DB=duobromart
POSTGRES_USER=duobromart
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000/api

# --- Email (used from Phase 2 onward: verification, resets, order emails) ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1

# --- Payment gateways (used from Phase 4 onward — never store raw card data) ---
PAYMENT_GATEWAY_PUBLIC_KEY=
PAYMENT_GATEWAY_SECRET_KEY=
